# ===========================================
# ConvertX Ops - AI Voice Receptionist
# Production Configuration
# ===========================================

# Application
APP_NAME=ConvertX Voice Agent
DEBUG=false
VERSION=2.0.0

# Telephony (Choose one: Twilio or Telnyx)
TWILIO_ACCOUNT_SID=AC_xxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Or Telnyx
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PHONE_NUMBER=+1234567890

# AI/LLM
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434

# Voice Configuration
ENABLE_TTS=true
DEFAULT_VOICE=en-IN-PrabhatNeural
ACCENT_MODE=indian
STT_LANGUAGE=en

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./data/voice_agent.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/voiceagent

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-secret-key-here-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-here-min-32-chars

# Paths
AUDIO_DIR=./uploads/audio
RECORDINGS_DIR=./recordings
LOGS_DIR=./logs

# Rate Limiting
RATE_LIMIT_CALLS_PER_MINUTE=10
MAX_CONCURRENT_CALLS=100
CALL_TIMEOUT_SECONDS=300

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# IMPORTANT: Never commit .env file!
# Copy this to .env and fill in real values