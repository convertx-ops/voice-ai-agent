# Voice + Brain System Configuration

# Application
APP_NAME=Voice + Brain
VERSION=1.0.0

# Ollama (must be running locally)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434

# Audio
SAMPLE_RATE=16000
CHUNK_SIZE=1024

# Whisper (speech recognition)
WHISPER_MODEL=base  # base, small, medium (larger = more accurate but slower)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# TTS (text-to-speech)
ENABLE_TTS=true
TTS_ENGINE=piper  # piper (local/offline) or edge (online/free tier)
PIPER_VOICE=en_US-lessac-medium
EDGE_VOICE=en-IN-PrabhatNeural

# Directories
MEMORY_DIR=./memory
RECORDINGS_DIR=./recordings
AUDIO_DIR=./audio
LOGS_DIR=./logs

# Note: Piper TTS requires downloading voice models separately
# Download from: https://github.com/rhasspy/piper/releases
# Extract and place in ~/.local/share/piper/models/